// to check perferct number or not
#include <stdio.h>
int main() {
    int num, sum = 0;
    printf("Enter a number: ");
    scanf("%d", &num);

    for (int i = 1; i < num; i++) {
        if (num % i == 0) {
            sum += i;
        }
    }

    if (sum == num) {
        printf("%d is a perfect number.\n", num);
    } else {
        printf("%d is not a perfect number.\n", num);
    }

    return 0;
}
// to check strong number or not
#include <stdio.h>
int factorial(int n) {
    if (n == 0 || n == 1) {
        return 1;
    }
    return n * factorial(n - 1);
}   
// to print prime factors of a number
#include <stdio.h>  
void primeFactors(int n) {  
    while (n % 2 == 0) {  
        printf("%d ", 2);  
        n = n / 2;  
    }  
    for (int i = 3; i <= sqrt(n); i = i + 2) {  
        while (n % i == 0) {  
            printf("%d ", i);  
            n = n / i;  
        }  
    }  
    if (n > 2) {  
        printf("%d ", n);  
    }  
}

int main() {  
    int n;  
    printf("Enter a number: ");  
    scanf("%d", &n);  
    printf("Prime factors of %d are: ", n);  
    primeFactors(n);  
    return 0;  
}

// to find largest prime factor of a number
#include <stdio.h>
#include <math.h>

int largestPrimeFactor(int n) {
    int maxPrime = -1;
    while (n % 2 == 0) {
        maxPrime = 2;
        n = n / 2;
    }
    for (int i = 3; i <= sqrt(n); i = i + 2) {
        while (n % i == 0) {
            maxPrime = i;
            n = n / i;
        }
    }
    if (n > 2) {
        maxPrime = n;
    }
    return maxPrime;
}

int main() {
    int n;
    printf("Enter a number: ");
    scanf("%d", &n);
    printf("Largest prime factor of %d is: %d\n", n, largestPrimeFactor(n));
    return 0;
}
