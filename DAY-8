#include <stdio.h>
int main ()
{
  // number triangle
  int r=5;
  for(int i=1;i<=r;i++)
  {
    for(int j=1;j<=i;j++)
    {
        printf("%d",j);
    }
  }
  return 0;
}
#include <stdio.h>
int main ()
{
    // character triangle
    int r=5;
    for(int i=1;i<=5;i++)
    {
        for(int j=0;j<i;j++)
        {
            printf("%c",'A'+j);
        }
        printf("\n");
    }
    
    return 0;
}
#include <stdio.h>
int main()
{
    //repeated number pattern
    int r=5;
    for(int i=1;i<=r;i++)
    {
        for(int j=0;j<i;j++)
        {
            printf("%d",i);
        }
        printf("\n");
    }
    return 0;
}
#include <stdio.h>
int main()
{
    // half pyramid pattern
    int r=5;
    for(int i=1;i<=r;i++)
    {
        for(int j=1;j<=i;j++)
        {
            printf("*");
        }
        printf("\n");
    }
    return 0;
}
