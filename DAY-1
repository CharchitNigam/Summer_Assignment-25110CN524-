    {
        printf ( "%d * %d = %d "  , n , i , n*i ) ;
        i++ ; 
    }
    return 0 ; 
}
// to find the factorial of a number
int main ()
{
    int n , i = 1 , fact = 1 ;
    printf ( "Enter a number : " ) ;
    scanf ( "%d" , &n ) ;
    while ( i <= n )
    {
        fact = fact * i ;
        i++ ; 
    }
    printf ( "Factorial of %d is %d " , n , fact ) ;
    return 0 ; 
}
// to count the digits in a number
