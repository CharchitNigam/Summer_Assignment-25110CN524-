#include <stdio.h>
int main() 
{
    int r, c;
    printf("Enter number of rows and columns: ");
    scanf("%d %d", &r, &c);
    if (r != c) 
    {
        printf("Diagonal sum requires a square matrix (Rows must equal Columns)!\n");
        return 1;
    }
    int m[r][c];
    for (int i = 0; i < r; i++)
    {
        for (int j = 0; j < c; j++)
        {
            printf("Enter values of [%d][%d]: ", i, j);
            scanf("%d", &m[i][j]);
        }
    }
    printf("\n\nVALUES ENTERED!!\n\n");
    int dsum = 0;
    for (int i = 0; i < r; i++) 
    {
        dsum += m[i][i]; 
    }
    printf("Sum of the main diagonal elements: %d\n", dsum);
    return 0;
}
