#include <stdio.h>
int main() 
{
    int r1,c1,r2,c2;
    printf("Enter rows and columns for Matrix 1: ");
    scanf("%d %d", &r1, &c1);
    int m1[r1][c1];
    for (int i = 0; i < r1; i++) 
    {
        for (int j = 0; j < c1; j++) 
        {
            printf("Enter value for Matrix 1 [%d][%d]: ", i, j);
            scanf("%d", &m1[i][j]);
        }
    }
    printf("\nEnter rows and columns for Matrix 2: ");
    scanf("%d %d", &r2, &c2);
    int m2[r2][c2];
    for (int i = 0; i < r2; i++) 
    {
        for (int j = 0; j < c2; j++) 
        {
            printf("Enter value for Matrix 2 [%d][%d]: ", i, j);
            scanf("%d", &m2[i][j]);
        }
    }
    if (r1 == r2 && c1 == c2) {
        printf("\nMATRICES CAN BE ADDED!!\n\n");
        int sum[r1][c1];
        for (int i = 0; i < r1; i++) 
        {
            for (int j = 0; j < c1; j++) 
            {
                sum[i][j] = m1[i][j] + m2[i][j];
            }
        }
        printf("Resulting Sum Matrix:\n");
        for (int i = 0; i < r1; i++) 
        {
            for (int j = 0; j < c1; j++)
            {
                printf("%d ", sum[i][j]);
            }
            printf("\n");
        }
    } 
    else 
    {
        printf("\nError: Matrices cannot be added! Dimensions do not match.\n");
    }

    return 0;
}

