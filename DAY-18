#include <stdio.h>
int main() 
{
    int noe;
    printf("Enter number of elements in the array: ");
    scanf("%d",&noe);
    int a[noe];
    for (int i=0;i<noe;i++) 
    {
        printf("Enter value: ");
        scanf("%d", &a[i]);
    }
    printf("Values entered successfully !!\n\n");
    for (int i = 0; i < noe - 1; i++)
    {
        for (int j = 0; j < noe - i - 1; j++) 
        {
            if (a[j] > a[j + 1]) 
            {
                int temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }
    printf("Sorted Array (Bubble Sort):\n");
    for (int i = 0; i < noe; i++) {
        printf("%d ", a[i]);
    }
    printf("\n");

    return 0;
}

#include <stdio.h>
int main()
{
    int noe;
