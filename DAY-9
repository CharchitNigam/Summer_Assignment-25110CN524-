#include <stdio.h>
int main()
{
    // reverse star pattern
    for(int i=5;i>=1;i--)
    {
        for(int j=1;j<=i;j++)
        {
            printf("*");
        }
        printf("\n");
    }
    return 0;
}

#include <stdio.h>
int main()
{
    //reverse number triangle
    int val=0;
    for(int i=5;i>=1;i--)
    {
        for(int j=1;j<=i;j++)
        {
            printf("%d",val+j);
        }
        printf("\n");
    }
    return 0;
}
#include <stdio.h>
int main ()
{
    // repeated character pattern
    char c='A';
    for(int i=0;i<5;i++)
    {
        for(int j=0;j<=i;j++)
        {
            printf("%c",c+i);
        }
        printf("\n");
    }
    return 0;
}
#include <stdio.h>
int main ()
{
    // hollow square pattern
    int l=0;
    for(l=0;l<=5;l++)
    {
        if(l==0 || l==5)
        {
            printf("*****\n");
        }
        else
        {
            printf("*   *\n");
        }
    }
    return 0;
}
