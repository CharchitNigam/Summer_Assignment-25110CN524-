#include <stdio.h>
// to find sum of digits of a number
int main() {        
    int num, sum = 0;
    printf("Enter a number: ");
    scanf("%d", &num);
    
    while (num != 0) {
        sum += num % 10; 
        num /= 10;
    }
    
    printf("Sum of digits: %d\n", sum);
    return 0;
}
// to reverse a number
#include <stdio.h>
int main() 
{
    int num, rev = 0;
    printf("Enter a number: ");
    scanf("%d", &num);
    
    while (num != 0)
    {
        rev = rev * 10 + num % 10; 
        num /= 10;
    }
    
    printf("Reversed number: %d\n", rev);
    return 0;
}
// to check if a number is palindrome
#include <stdio.h>  
int main() 
{  
    int num, rev = 0, t;  
    printf("Enter a number: ");  
    scanf("%d", &num);  
    t = num;  
    while (t != 0) 
    {  
        rev = rev * 10 + t % 10;  
        t = t / 10;  
    }  
    if (num == rev) 
    {  
        printf ("%d is a palindrome number.\n", num);  
    } else 
    {  
        printf ("%d is not a palindrome number.\n", num);  
    }  
    return 0;  
}
