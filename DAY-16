#include <stdio.h>
int main ()
{
    // maximum frequency element
    int noe;
    printf("Enter numbe of elements:");
    scanf("%d",&noe);
    int a[noe];
    for(int i=0;i<noe;i++)
    {
        printf("Enter value: ");scanf("%d",&a[i]);
    }
    printf("\n\nVALUES ENTERED!\n\n");
    int cnt=0;
    int maxele=a[0];
    int maxcnt=0;
    for(int i=0;i<noe;i++)
    {
        int cnt=0;
        for(int j=0;j<noe;j++)
        {
            if(a[i]==a[j])
            {
                cnt++;
            }
        }
        if(cnt>maxcnt)
        {
            maxcnt=cnt;
            maxele=a[i];
        }
    }
    printf("Maxmimum frequency element : %d\n",maxele);
    printf("%d times",maxcnt);
    return 0;
    
}

#include <stdio.h>

int main() {
    int noe = 5;
    int a[5] = {1, 23, 45, 98, 77}; 
    int target_sum = 68;            
    int found = 0;
    printf("Target sum to find: %d\n", target_sum);
    for (int i = 0; i < noe; i++) {
        for (int j = i + 1; j < noe; j++) {
            if (a[i] + a[j] == target_sum) {
                printf("Pair found: %d and %d (at indices %d and %d)\n", a[i], a[j], i, j);
                found = 1;
            }
        }
    }

    if (!found) {
        printf("No pair found with the given sum.\n");
    }
    return 0;
}
