#include <stdio.h>
int sod(int);
int main()
{
    // recursive sum of digits
    int n;
    printf("Enter a number:");
    scanf("%d",&n);
    int sum=sod(n);
    printf("Sum of digits:%d",sum);
    return 0;
    
}
int sod(int s)
{
    if (s==0) 
    {
        return 0;
    }
    return (s%10)+sod(s/10);
}#include <stdio.h>

int revnum(int onum, int rev); 

int main() {
    int num;
    printf("Enter a number: ");
    scanf("%d", &num);
    
    int rev = revnum(num, 0); 
    
    printf("Reverse of the number %d is %d.\n", num, rev);
    return 0;
}

int revnum(int onum, int rev) 
{
    if (onum == 0) {
        return rev;
    }
    return revnum(onum / 10, rev * 10 + (onum % 10));
}
