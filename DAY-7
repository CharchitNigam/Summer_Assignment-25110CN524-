#include <stdio.h>
int fact(int);
int main ()
{
    // recursive factorial
    int n; 
    printf("Enter a number: "); 
    scanf("%d",&n);
    int f=fact(n);
    printf("Factorial of %d is %d",n,f);
    return 0;
    
}
int fact(int x)
{
    if (x<=1)
    {
        return 1;
    }
    return x*fact(x-1);
    
}
