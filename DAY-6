// wap to convert decimal to binary 
#include <stdio.h>
int main() 
{
    int dec, bin = 0, rema, base = 1;
    
    printf("Enter a decimal number: ");
    scanf("%d", &dec);
    
    while (dec > 0) {
        rema = dec % 2;
        bin += rema * base;
        dec /= 2;
        base *= 10;
    }
    
    printf("Binary equivalent: %d\n", bin);
    
    return 0;
}
// to convert binary to decimal
#include <stdio.h>
int main() 
{
    int bin, dec = 0, rema, base = 1;
    
    printf("Enter a binary number: ");
    scanf("%d", &bin);
    
    while (bin > 0) {
        rema = bin % 10;
        dec += rema * base;
        bin /= 10;
        base *= 2;
    }
    
    printf("Decimal equivalent: %d\n", dec);
    
    return 0;
}
// to count set bits in a number
#include <stdio.h>
int main()
{
    int num, cnt = 0;
    
    printf("Enter a number: ");
    scanf("%d", &num);
    
    while (num > 0) {
        if (num % 2 == 1) {
            cnt++;
        }
        num /= 2;
    }
    
    printf("Number of set bits: %d\n", cnt);
    
    return 0;
}
// to find x^n without using pow function
#include <stdio.h>
int main()
{
    int x, n;
    long r = 1;
    
    printf("Enter base (x): ");
    scanf("%d", &x);
    
    printf("Enter exponent (n): ");
    scanf("%d", &n);
    
    for (int i = 0; i < n; i++) {
        r = r * x;
    }
    
    printf("%d^%d = %ld\n", x , n , r );
    
    return 0;
}
