#include <stdio.h>
int fact(int);
int main()
{
    int n,f;
    printf("Enter number:");scanf("%d",&n);
    f=fact(n);
    printf("Factorial is:%d",f);
    return 0;
}
int fact(int num)
{
    if(num<=1)
    {
        printf("Value is:1\n");return 1;
    }
    else
    {
        int pdt=1;
        for(int i=1;i<=num;i++)
        {
            pdt=pdt*i;
        }
        return pdt;
    }
}
