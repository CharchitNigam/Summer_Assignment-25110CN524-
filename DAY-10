#include <stdio.h>
int main ()
{
    // star pyramid
    int tr=5;
    for(int i=1;i<=tr;i++)
    {
        for(int j=1;j<=(2*i-1);j++)
        {
            printf("*");
        }
        printf("\n");
    }
    return 0;
}
#include <stdio.h>
int main ()
{
    // reverse star pyramid
    int tr=5;
    for(int i=tr;i>=1;i--)
    {
        for(int j=1;j<=(2*i-1);j++)
        {
            printf("*");
        }
        printf("\n");
    }
    return 0;
}
#include <stdio.h>
int main ()
{
    // number pyramid
    int r=5,n=1;
    for(int i=1;i<=r;i++)
    {
        for(int j=1;j<=i;j++)
        {
            printf("%d",j);
        }
        for(int j=i-1;j>=1;j--)
        {
            printf("%d",j);
        }
        printf("\n");
    }
    return 0;
}
